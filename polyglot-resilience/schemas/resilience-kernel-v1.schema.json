{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dossiya-SE/Dossiya-SE/polyglot-resilience/schemas/resilience-kernel-v1.schema.json",
  "title": "Polyglot Resilience Kernel PRK-1.0 Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kernel_version",
    "fixture_id",
    "dt",
    "x",
    "D",
    "A",
    "r",
    "h",
    "B",
    "u",
    "weights"
  ],
  "properties": {
    "kernel_version": {"const": "PRK-1.0"},
    "fixture_id": {"type": "string", "minLength": 1},
    "dt": {"type": "number", "exclusiveMinimum": 0},
    "x": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "D": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
    },
    "A": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
    },
    "r": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0}
    },
    "h": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "B": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "number"}}
    },
    "u": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number"}
    },
    "weights": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0}
    }
  },
  "$comment": "JSON Schema validates local scalar/array types and bounds. Cross-field dimension equality and sum(weights)=1 are enforced by the semantic-contract validators."
}
